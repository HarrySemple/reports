%         \enorm{e} \leq \frac{2C}{\alpha} \inf_{v_h\in V_h}\snorm{u-v_h}.
%     \end{equation}
% \end{proof}

\begin{corollary}[Rates of Convergence]
    \label{cor:FE-conv-rate}
    Let $k\geq 1$ denote the piecewise polynomial degree of elements of $V_h$.
    Suppose the exact solution $u\in H_0^r(\Omega)$ of~\eqref{eqn:strong} is such that $r$ is sufficiently large for $u$ to belong to the domain of the Lagrange interpolation operator. Then, there exists a constant $C$ such that
    \begin{equation}
        \enorm{u-u_h} \leq C h^{\min\{k+1,r\} - 1/2} |u|_{H^r(\Omega)}.
    \end{equation}
\end{corollary}
\begin{proof}
    The proof follows that of~\cite{ashby2025nodally}, Corollary 3.5; we provide a brief overview.
    Denote by $\mathcal{I}u\in V_h$ the piecewise polynomial Lagrange interpolant of $u$ onto the finite element space $V_h$.
    Taking $v_h = \mathcal{I}u$ in Theorem~\ref{thm:best-approx}, we have
    \begin{equation}
        \label{eqn:FE-conv-1}
        \begin{aligned}
            \enorm{u-u_h}^2
            &\leq
            \snorm{u-\mathcal{I}u}^2 \\
            &= \mu \ltwo{u-\mathcal{I}u}^2
            + \sum_{K\in\mathscr{T}} \delta_K \ltwok{\mathbf{b}\cdot\nabla (u-\mathcal{I}u)}^2\\
            &\qquad \qquad + \||\mathbf{b}\cdot\mathbf{n}|^{1/2}(u-\mathcal{I}u)\|_{L^2(\partial\Omega)}^2
            + \sum_{K\in\mathscr{T}} \delta_K^{-1}\ltwok{u-\mathcal{I}u}^2.
        \end{aligned}
    \end{equation}
    Each of these terms are bounded using standard interpolation estimates~\cite{ern2021finite}, which apply to norms over $L^2(\Omega)$ and $L^2(K)$. The third term is first bounded by a trace estimate (see e.g.~\cite{evans2022partial}, Section 5.5) in terms of these norms. The following estimates combine to give~\eqref{eqn:FE-conv-1}:
    \begin{equation}
        \|u - \mathcal{I}u\|_{L^2(\Omega)} \leq C_I \, h_K^r \, |u|_{H^r(\Omega)},
    \end{equation}

    \begin{equation}
        \left\| \delta_K^{1/2} \, \mathbf{b} \cdot \nabla (u - \mathcal{I}u) \right\|_{L^2(K)}
        \leq C_I \, \|\mathbf{b}\|_{\infty,K} \, C_\delta^{1/2} \, h_K^{r - \tfrac{1}{2}} \, |u|_{H^r(\Omega)}, 
    \end{equation}

    \begin{equation}
        \begin{aligned}
             \left\||\mathbf{b}\cdot\mathbf{n}|(u-\mathcal{I}u)\right\|_{L^2(\partial\Omega\cap K)}
            &\leq C_{\mathrm{tr}} \left( h_K^{-1/2} \|u - Iu\|_{L^2(K)} + h_K^{1/2} \|\nabla (u - Iu)\|_{L^2(K)} \right)\\
            &\leq 2 C_{\mathrm{tr}} C_I \, h_K^{r - \tfrac{1}{2}} \, |u|_{H^r(\Omega)},
        \end{aligned}
    \end{equation}

    \begin{equation}
        \delta_K^{-1/2} \, \|u - \mathcal{I}u\|_{L^2(K)}
        \leq C_I \, C_\delta^{-1/2} \, h_K^{r - \tfrac{1}{2}} \, |u|_{H^r(\Omega)}.
    \end{equation}
    where $C_{\mathrm{tr}}$ and $C_\mathcal{I}$ are constants for trace and interpolation estimates, respectively.
\end{proof}

</subsection>

<subsection xml:id="sec-iter-det">
    <title>Fixed Point Error</title>
    <p>
        Now, we turn to the second error term in the triangle inequality~\eqref{eqn:triangle-ineq}. That is, we now derive a convergence rate for $\enorm{u_h - u_h^{(n)}}$. In doing so, we also find a rate in the $L^2(\Omega)$-norm.
    </p>
    
\begin{lemma}[Contraction in mixed norms]
    \label{lem:cont-mix}
    Let $u_h\in V_h$ be the solution of the stationary finite element problem~\eqref{eqn:FE-problem}. Take $u_h^{(0)}\in V_h$ and denote by $\{u_h^{(n)}\}_{n\in\mathbb{N}_0}$ the sequence of solutions to the iterative problem~\eqref{eqn:iter-problem}. We have that, for all $n\in \mathbb{N}_0$
    \begin{equation}
        \enorm{u_h-u_h^{(n)}} 
        \leq
        2\tilde{C}_s 
        \ltwo{u_h - u_h^{(n-1)}}.
    \end{equation}
\end{lemma}
\begin{proof}
    Let $e = u_h - u_h^{(n)}$
    By coercivity of $a(\cdot,\cdot)$ (Lemma~\ref{lem:a-coer}), 
    \begin{equation}
        \begin{aligned}
            \frac{1}{2}\enorm{e}^2
            &\leq
            a(e,e)\\
            &=
            a(u_h,e) - a(u_h^{(n)},e)\\
            &=
            s(u_h,e) + l(e) - s(u_h^{(n-1)},e) - l(e)\\
            &=
            s(u_h-u_h^{(n-1)},e)\\
            \text{by Lemma~\ref{lem:s-cont},}\\
            &\leq
            \tilde{C}_s \ltwo{u_h-u_h^{(n-1)}}\enorm{e}.
        \end{aligned}
    \end{equation}
    Thus,
    \begin{equation}
        \enorm{e} 
        \leq
        2\tilde{C}_s 
        \ltwo{u_h - u_h^{(n-1)}}.
    \end{equation}
\end{proof}

\begin{theorem}[Convergence in $L^2(\Omega)$-norm]
    \label{thm:conv-l2}
    Let $u_h\in V_h$ be the solution of the stationary finite element problem~\eqref{eqn:FE-problem}. Take $u_h^{(0)}\in V_h$ and denote by $\{u_h^{(n)}\}_{n\in\mathbb{N}_0}$ the sequence of solutions to the iterative problem~\eqref{eqn:iter-problem}. We have that, for all $n\in \mathbb{N}_0$
    \begin{equation}
        \label{eqn:conv-l2}
        \ltwo{u_h-u_h^{(n)}} 
        \leq
        \left(
            \frac{2\tilde{C}_s}{\mu^{1/2}}
        \right)^n
        \ltwo{u_h - u_h^{(0)}}.
    \end{equation}
\end{theorem}
\begin{proof}
    By the relation of norms~\eqref{eqn:rel-norms}, we have
    \begin{equation}
        \ltwo{u_h-u_h^{(n)}} \leq \frac{1}{\mu^{1/2}}\enorm{u_h-u_h^{(n)} }.
    \end{equation}
    Applying Lemma~\ref{lem:cont-mix} gives
    \begin{equation}
        \label{eqn:cont-l2}
        \ltwo{u_h-u_h^{(n)}} 
        \leq
        \frac{2\tilde{C}_s}{\mu^{1/2}}
        \ltwo{u_h - u_h^{(n-1)}}.
    \end{equation}
    Iterating~\eqref{eqn:cont-l2} yields the desired convergence result.
\end{proof}


\begin{corollary}[Convergence in SUPG-norm]
    \label{cor:conv-sugp}
    Let $u_h\in V_h$ be the solution of the stationary finite element problem~\eqref{eqn:FE-problem}. Take $u_h^{(0)}\in V_h$ and denote by $\{u_h^{(n)}\}_{n\in\mathbb{N}_0}$ the sequence of solutions to the iterative problem~\eqref{eqn:iter-problem}. We have that, for all $n\in \mathbb{N}_0$
    \begin{equation}
        \enorm{u_h-u_h^{(n)}} 
        \leq
        2\tilde{C}_s
        \left(
            \frac{2\tilde{C}_s}{\mu^{1/2}}
        \right)^{n-1}
        \ltwo{u_h - u_h^{(0)}}.
    \end{equation}
\end{corollary}
\begin{proof}
    The result follows from combining Lemma~\ref{lem:cont-mix} and Theorem~\ref{thm:conv-l2}.
\end{proof}

<\subsection>

<subsection xml:id="sec-combined-det">
    <title>Combined Error Estimate</title>
    <p>
We can now populate the triangle inequality for iterative solution error originally proposed in~\eqref{eqn:triangle-ineq}.
    </p>



\begin{theorem}[Error Estimate in the Deterministic Setting]
    \label{thm:det}
    Let $u$ be the solution of~\eqref{eqn:strong} and suppose $u_h\in V_h$ is the solution of the stationary finite element problem~\eqref{eqn:FE-problem}. Take $u_h^{(0)}\in V_h$ and denote by $\{u_h^{(n)}\}_{n\in\mathbb{N}_0}$ the sequence of solutions to the iterative problem~\eqref{eqn:iter-problem}. We have that, for all $n\in \mathbb{N}_0$
    \begin{equation}
        \enorm{u-u_h^{(n)}}
        \leq
        C h^{\min\{k+1,r\} - 1/2} |u|_{H^r(\Omega)}
        +
        2\tilde{C}_s
        \left(
            \frac{2\tilde{C}_s}{\mu^{1/2}}
        \right)^{n-1}
        \ltwo{u_h - u_h^{(0)}}.
    \end{equation}
\end{theorem}
\begin{proof}
    By the triangle inequality, 
    \begin{equation}
        \enorm{u-u_h^{(n)}}
        \leq
        \enorm{u-u_h}
        +
        \enorm{u_h-u_h^{(n)}},
    \end{equation}
    and the result follows from applying Corollary~\ref{cor:conv-sugp} and Corollary~\ref{cor:FE-conv-rate}.
\end{proof}

</subsection>

<subsection>
    <title>Discussion</title>
    <p>
The analysis above identifies two key constraints on 
the parameters of the problem.        
    </p>

    <p>
First, the combined coercivity result for $a - s$ 
(Corollary~\ref{lem:a-s-coer}) and the contraction rate for 
source iteration (Theorem~\ref{thm:conv-l2} and 
Corollary~\ref{cor:conv-sugp}) both rely on the single 
constraint
\begin{equation}
    \label{eqn:Cs-condition}
    C_s = \frac{\linf{\sigma_T}\,\ldouble{\mathcal{K}}}{\mu}
    \left(1 + (\mu\,\delta_{\max})^{1/2}\right)
    \;\leq\; \tfrac{1}{2}.
\end{equation}
This is a subcriticality condition on the scattering 
operator: it requires the scattering cross section 
$\sigma_T$, kernel mass $\ldouble{\mathcal{K}}$, and 
stabilisation parameter $\delta_{\max}$ to be small relative 
to the positivity constant $\mu$. Physically, this refers to
absorption effects sufficiently dominating over scattering. 
    </p>

    <p>
Second, the coercivity proof for $a$ (Lemma~\ref{lem:a-coer}) requires
\begin{equation}
    \label{eqn:delta-condition}
    \delta_{\max} \;\leq\; \frac{\mu}{\linf{\sigma}^2},
\end{equation}
which prevents the indefinite SUPG cross term 
$\delta_K \sigma v\,(\mathbf{b}\cdot\nabla v)$ from 
overwhelming the streamline diffusion contribution. The 
standard SUPG scaling $\delta_K = h_K$ used in our numerical 
experiments satisfies~\eqref{eqn:delta-condition} for 
sufficiently fine meshes, namely 
$h \leq \mu/\linf{\sigma}^2$.
    </p>



</section>