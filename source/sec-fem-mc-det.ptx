<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-fem-mc-det" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Deterministic Analysis</title>

  <p> Text of section. </p>

<subsection>
    <title>Introduction</title>
    <p>
        In this section, we present a preliminary error analysis under the simplifying assumption that $\mathcal{S}$ is computed exactly. We define the norms used throughout, before establishing well-posedness through verifying the conditions for the Lax-Milgram theorem. We then derive separate bounds for the discretisation error $\enorm{u-u_h}$ and the iteration error $\enorm{u_h-u_h^{(n)}}$, which combine via the triangle inequality to give the main deterministic estimate. For simplicity, we take $g=0$ (meaning $u\in H_0^1$) from this section onwards - an extension to nonhomogenous inflow data is left to future work.
    </p>  
</subsection>

<subsection>
    <title>Norms</title>
    <p>
        We equip $V_h$ with the SUPG norm, defined as
        \begin{equation}
            \label{eqn:supg-norm}
            \enorm{v}^2 := \mu\ltwo{v}^2 
            + \sum_{K\in\mathscr{T}_h} \delta_K \ltwok{\mathbf{b}\cdot\nabla v}^2
            + \int_{\partial\Omega} |\mathbf{b}\cdot\mathbf{n}| v^2 \, \mathrm{d}S,
        \end{equation}
        where $\mu$ is the positivity constant defined in~\eqref{eqn:positivity} and $\delta_K$ is the element-wise stabilisation parameter.
        This immediately results in the following relation of norms, used frequently in later analysis
        \begin{equation}
            \label{eqn:rel-norms}
            \enorm{v}^2 \geq \mu\ltwo{v}^2 \qquad \forall v\in V_h.
        \end{equation}
        For continuity estimates, we also require the stronger star-SUPG norm, given by
        \begin{equation}
            \label{eqn:star-supg-norm}
            \snorm{v}^2 = \enorm{v}^2 + \sum_{K\in\mathscr{T}} \delta_K^{-1} \ltwok{v}^2.
        \end{equation}
    </p>
</subsection>


<subsection>
    <title>Well-Posedness and Key Properties</title>
    <p>
        We now present key properties of the bilinear and linear forms defined in~\eqref{eqn:a},~\eqref{eqn:s} and~\eqref{eqn:l}. This will show that the variational problem~\eqref{eqn:FE-problem} is well-posed, and provide the necessary results for error analysis.
    </p>
    <lemma xml:id="lem-well-posed">
        <title>Consistency of the SUPG Method</title>
        <statement>
            <p>
                \label{lem:well-posed}
                Let $u$ be the true solution of~\eqref{eqn:strong-simple}. Then for all $v\in V_h$ we have 
                \begin{equation}
                    a(u,v) = s(u,v) + l(v).
                \end{equation}
            </p>
        </statement>
    </lemma>
    <proof>
        <p>
            We have 
            \begin{equation}
                \begin{aligned}
                    a(u,v) - s(u,v) - l(v) =&
                    \int_{\Omega} (\mathbf{b}\cdot\nabla u + \sigma u - \mathcal{S}u - q) v \, \mathrm{d}x\\
                    &+ \sum_{K\in\mathscr{T}_h} \int_K \delta_K (\mathbf{b}\cdot\nabla u + \sigma u - \mathcal{S}u - q)(\mathbf{b}\cdot\nabla v) \, \mathrm{d}x\\
                    &- \int_{\Gamma_-} (\mathbf{b}\cdot\mathbf{n})(u-g)v\, ds\\
                    =& 0.
                \end{aligned}
            \end{equation}
        </p>
    </proof>
    



\begin{lemma}[Coercivity of $a(\cdot,\cdot)$]
    \label{lem:a-coer}
    For all $v\in V_h$ we have 
    \begin{equation}
        a(v,v) \geq \frac{1}{2}\enorm{v}^2.
    \end{equation}    
\end{lemma}
\begin{proof}
    We treat each term in~\eqref{eqn:a} separately.
    For the convection term, by Green's formula~\eqref{eqn:greens} we have
    \begin{equation}
        \begin{aligned}
            \int_{\Omega} (\mathbf{b} \cdot \nabla v)\, v \, \mathrm{d}x 
            &= \frac{1}{2} \int_{\Omega} \mathbf{b} \cdot \nabla (v^2)\, \mathrm{d}x \\
            &= \frac{1}{2} \int_{\partial \Omega} (\mathbf{b} \cdot \mathbf{n})\, v^2 \, \mathrm{d}S .  
        \end{aligned}
    \end{equation}
    We combine this with the boundary inflow term. Let $\Gamma_+ = \partial\Omega\setminus\Gamma_-$. We have
    \begin{equation}
        \begin{aligned}
            \frac{1}{2} \int_{\partial \Omega} (\mathbf{b} \cdot \mathbf{n})\, v^2 \, \mathrm{d}S 
            - \int_{\Gamma_-} (\mathbf{b} &\cdot \mathbf{n})\, v^2 \, \mathrm{d}S \\
            &= \frac{1}{2}\int_{\Gamma_+} (\mathbf{b} \cdot \mathbf{n})\, v^2 \, \mathrm{d}S 
            - \frac{1}{2}\int_{\Gamma_-} (\mathbf{b} \cdot \mathbf{n})\, v^2 \, \mathrm{d}S \\
            &= \frac{1}{2}\int_{\partial\Omega} |\mathbf{b} \cdot \mathbf{n}|\, v^2 \, \mathrm{d}S,
        \end{aligned}
    \end{equation}
    where the last equality follows from definition of $\Gamma_-$ in~\eqref{eqn:strong-bcs}.
    Combined with the reaction term, we have
    \begin{equation}
        \begin{aligned}
            \label{eqn:coer-a-1}
            \int_{\Omega} (\mathbf{b} \cdot \nabla v)\, v + \sigma v^2\, \mathrm{d}x 
            - \int_{\Gamma_-} (\mathbf{b} &\cdot \mathbf{n})\, v^2 \, \mathrm{d}S\\
            &= \int_{\Omega} \sigma v^2\, \mathrm{d}x 
            + \frac{1}{2}\int_{\partial\Omega} |\mathbf{b} \cdot \mathbf{n}|\, v^2 \, \mathrm{d}S\\
            &\geq \mu\ltwo{v}^2 + \frac{1}{2}\int_{\partial\Omega} |\mathbf{b} \cdot \mathbf{n}|\, v^2 \, \mathrm{d}S.
        \end{aligned}
    \end{equation}
    Now, we turn to the SUPG term. We have
    \begin{equation}
        \begin{aligned}
            \sum_{K \in \mathscr{T}_h}
            \int_K
            \delta_K \, (\boldsymbol{b}\cdot\nabla v &+ \sigma v)\,
            (\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x\\
            &=
            \sum_{K \in \mathscr{T}_h} 
            \int_K
            \delta_K \, |\boldsymbol{b}\cdot\nabla v |^2\, \mathrm{d}x
            + \sum_{K \in \mathscr{T}_h} \int_K \delta_K \sigma v\, (\mathbf{b} \cdot \nabla v)\, dx\\
            &=
            \sum_{K \in \mathscr{T}_h} \delta_K \|\mathbf{b} \cdot \nabla v\|_{L^2(K)}^2
            + \sum_{K \in \mathscr{T}_h} \int_K \delta_K \sigma v\, (\mathbf{b} \cdot \nabla v)\, dx\\
        \end{aligned}
    \end{equation}
    The second term is indefinite, and we bound its contribution with Young's inequality~\eqref{eqn:youngs}
    \begin{equation}
        \left| \int_K \delta_K \sigma v\, (\mathbf{b} \cdot \nabla v)\, dx\right|
        \leq
        \frac{1}{2}\,\delta_K \|\mathbf{b} \cdot \nabla v\|_{L^2(K)}^2
+ \frac{1}{2}\,\delta_K \linf{\sigma}^2 \|v\|_{L^2(K)}^2.
    \end{equation}
    Thus, the SUPG Term is bounded below by
    \begin{equation}
        \begin{aligned}
            \label{eqn:coer-a-2}
            \sum_{K \in \mathscr{T}_h}
            \int_K
            \delta_K \, (\boldsymbol{b}\cdot\nabla v &+ \sigma v)\,
            (\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x\\
            &\geq 
            \sum_{K \in \mathscr{T}_h} \delta_K \|\mathbf{b} \cdot \nabla v\|_{L^2(K)}^2
            -
            \sum_{K \in \mathscr{T}_h}
            \frac{1}{2}\,\delta_K \|\mathbf{b} \cdot \nabla v\|_{L^2(K)}^2\\
            &\qquad \qquad - 
            \sum_{K \in \mathscr{T}_h}
            \frac{1}{2}\,\delta_K \linf{\sigma}^2 \|v\|_{L^2(K)}^2\\
            &=
            \frac{1}{2}
            \sum_{K \in \mathscr{T}_h}
            \delta_K \|\mathbf{b} \cdot \nabla v\|_{L^2(K)}^2 
            - 
            \frac{1}{2}
            \sum_{K \in \mathscr{T}_h}
            \delta_K \linf{\sigma}^2 \|v\|_{L^2(K)}^2.
        \end{aligned}
    \end{equation}
    By~\eqref{eqn:delta-bound}, we have $\delta_K \leq \mu/\linf{\sigma}^2$. Thus,
    \begin{equation}
        \label{eqn:coer-a-3}
        \begin{aligned}
            \sum_{K \in \mathscr{T}_h}
            \int_K
            \delta_K \, (\boldsymbol{b}\cdot\nabla v &+ \sigma v)\,
            (\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x\\
            &\geq 
            \frac{1}{2}
            \sum_{K \in \mathscr{T}_h}
            \delta_K \|\mathbf{b} \cdot \nabla v\|_{L^2(K)}^2 
            - 
            \frac{\mu}{2}\ltwo{v}^2
        \end{aligned}
    \end{equation}
    Adding~\eqref{eqn:coer-a-1} and~\eqref{eqn:coer-a-3}, we have
    \begin{equation}
        \begin{aligned}
            a(v, v) 
            &\geq \frac{\mu}{2} \|v\|_{L^2(\Omega)}^2
            + \frac{1}{2} \sum_K \delta_K \|\mathbf{b} \cdot \nabla v\|_{L^2(K)}^2
            + \frac{1}{2} \| |\mathbf{b} \cdot \mathbf{n}|^{1/2} v\|_{L^2(\partial\Omega)}^2\\
            &\geq \frac{1}{2} \enorm{v}^2.
        \end{aligned}
    \end{equation}
\end{proof}


\begin{lemma}[Continuity of $a(\cdot,\cdot)$]
    \label{lem:a-cont}
    For all $w,v\in V_h$ we have that
    \begin{equation}
        \label{eqn:a-cont}
        a(w,v) \leq C_a \snorm{w} \enorm{v},
    \end{equation}
    where $C_a = 5 + \linf{\sigma}/\mu$.
\end{lemma}
\begin{proof}
    We bound every term of~\eqref{eqn:a} in the form of~\eqref{eqn:a-cont}.
    Beginning with the convection term, we apply Green's formula
    \begin{equation}
        \label{eqn:a-cont-01}
        \begin{aligned}
            \int_\Omega (\mathbf{b}\cdot \nabla w)\,v\,\mathrm{d}x
            =
            \int_{\partial\Omega} (\mathbf{b}\cdot\mathbf{n})\,wv\,\mathrm{d}S
            -
            \int_\Omega (\mathbf{b}\cdot \nabla v)\,w\,\mathrm{d}x.
        \end{aligned}
    \end{equation}
    We bound the first term in~\eqref{eqn:a-cont-01} as
    \begin{equation}
        \begin{aligned}
            \left|
                \int_{\partial\Omega} (\mathbf{b}\cdot\mathbf{n})\,wv\,\mathrm{d}S
            \right|
            &\leq
            \int_{\partial\Omega} 
            |\mathbf{b}\cdot\mathbf{n}|\,|w||v|\,
            \mathrm{d}S\\
            &\leq
            \left|\int_{\partial\Omega} 
            |\mathbf{b}\cdot\mathbf{n}|
            \,w^2\,\mathrm{d}S\right|^{1/2}
            \left|\int_{\partial\Omega} 
            |\mathbf{b}\cdot\mathbf{n}|
            \,v^2\,\mathrm{d}S\right|^{1/2}\\
            &\leq
            \enorm{w}
            \enorm{v}\\
            &\leq
            \snorm{w}
            \enorm{v}.
        \end{aligned}
    \end{equation}
    The second term in~\eqref{eqn:a-cont-01} is bounded as
    \begin{equation}
        \begin{aligned}
            \left|
                \int_\Omega (\mathbf{b}\cdot \nabla v)\,w\,\mathrm{d}x
            \right|
            &\leq
            \sum_{K \in \mathscr{T}_h}
            \left|\int_K (\mathbf{b}\cdot \nabla v)\,w\,\mathrm{d}x\right|\\
            &\leq
            \sum_{K \in \mathscr{T}_h}
            \ltwok{\mathbf{b}\cdot \nabla v} \ltwok{w}\\
            &\leq            
            \sum_{K \in \mathscr{T}_h}
            \delta_K^{1/2}\ltwok{\mathbf{b}\cdot \nabla v} 
            \delta_K^{-1/2}\ltwok{w}\\
            &\leq
            \left(\sum_{K \in \mathscr{T}_h}
            \delta_K \ltwok{\mathbf{b}\cdot \nabla v}^2 \right)^{1/2}
            \left(\sum_{K \in \mathscr{T}_h}
            \delta_K^{-1} \ltwok{w}^2\right)^{1/2}\\
            &\leq
            \enorm{v}\snorm{w}.\\
        \end{aligned}
    \end{equation}
    Thus, the convection term is bounded as
    \begin{equation}
        \begin{aligned}
            \label{eqn:a-cont-1}
            \left|\int_\Omega (\mathbf{b}\cdot \nabla w)\,v\,\mathrm{d}x\right|
            &\leq
            2\snorm{w}\enorm{v}.
        \end{aligned}
    \end{equation}
    The reaction term is bounded by
    \begin{equation}
        \begin{aligned}
            \label{eqn:a-cont-2}
            \left| \int_{\Omega} \sigma v w \, dx \right|
            &\leq \linf{\sigma} \|w\|_{L^2} \|v\|_{L^2}\\
            &\leq \frac{\linf{\sigma}}{\mu}\snorm{w}\enorm{v}.
        \end{aligned}
    \end{equation}
    The inflow boundary term is bounded by
    \begin{equation}
        \begin{aligned}
            \label{eqn:a-cont-3}
            \left| \int_{\Gamma_-} (\mathbf{b} \cdot \mathbf{n}) \, w v \, \mathrm{d}S \right|
            &\leq 
            \int_{\Gamma_-} 
            |\mathbf{b} \cdot \mathbf{n}|
            \, |w| |v| \, \mathrm{d}S\\
            &\leq
            \left(
                \int_{\Gamma_-} |\mathbf{b}\cdot\mathbf{n}|\,w^2\,\mathrm{d}S
            \right)^{1/2}
            \left(
                \int_{\Gamma_-} |\mathbf{b}\cdot\mathbf{n}|\,v^2\,\mathrm{d}S
            \right)^{1/2}\\
            &\leq
            \left(
                \int_{\partial\Omega} |\mathbf{b}\cdot\mathbf{n}|\,w^2\,\mathrm{d}S
            \right)^{1/2}
            \left(
                \int_{\partial\Omega} |\mathbf{b}\cdot\mathbf{n}|\,v^2\,\mathrm{d}S
            \right)^{1/2}\\
            &\leq
            \enorm{w}
            \enorm{v}\\
            &\leq
            \snorm{w}
            \enorm{v}
        \end{aligned}
    \end{equation}
    For the SUPG term, we have
    \begin{equation}
        \label{eqn:supg-continuity}
        \begin{aligned}
            \sum_{K \in \mathscr{T}_h}
            \int_K
            \delta_K \, (\boldsymbol{b}\cdot\nabla w &+ \sigma w)\,
            (\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x\\
            &=
            \sum_{K \in \mathscr{T}_h}
            \int_K
            \delta_K \, (\boldsymbol{b}\cdot\nabla w)\,
            (\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x\\
            & \qquad\qquad+
            \sum_{K \in \mathscr{T}_h}
            \int_K
            \delta_K \, \sigma w\,
            (\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x.
        \end{aligned}
    \end{equation}
    We bound the first RHS term of~\eqref{eqn:supg-continuity} as
    \begin{equation}
        \begin{aligned}
            \label{eqn:a-cont-4}
            &\left|\sum_{K \in \mathscr{T}_h}            
            \int_K\delta_K  
            (\boldsymbol{b}\cdot\nabla w)\,(\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x
            \right|\\
            &\qquad\qquad\leq
            \left(\sum_{K \in \mathscr{T}_h}
            \delta_K \ltwok{\mathbf{b}\cdot \nabla w}^2 \right)^{1/2}
            \left(\sum_{K \in \mathscr{T}_h}
            \delta_K \ltwok{\mathbf{b}\cdot \nabla v}^2 \right)^{1/2}\\
            &\qquad\qquad\leq
            \snorm{w}\enorm{v}
        \end{aligned}
    \end{equation}
    we bound the second term in~\eqref{eqn:supg-continuity} as
    \begin{equation}
        \label{eqn:a-cont-5}
        \begin{aligned}
            \left|\sum_{K \in \mathscr{T}_h}
            \int_K
            \delta_K \, \sigma w\,
            (\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x\right|
            &\leq
            \linf{\sigma}
            \sum_{K \in \mathscr{T}_h}
            \delta_K
            \ltwok{w}\ltwok{\mathbf{b}\cdot\nabla v}\\
            &\leq
            \linf{\sigma}
            \left(
                \sum_{K \in \mathscr{T}_h}
                \delta_K
                \ltwok{w}^2
            \right)^{1/2}
            \left(
                \sum_{K \in \mathscr{T}_h}
                \delta_K
                \ltwok{\mathbf{b}\cdot\nabla v}^2
            \right)^{1/2}\\
            &\leq
            \linf{\sigma}
            \delta_\text{max}^{1/2} 
            \ltwo{w}
            \enorm{v}\\
            &\leq
            \linf{\sigma}
            \delta_\text{max}^{1/2}
            \frac{1}{\mu^{1/2}}
            \snorm{w}
            \enorm{v}\\
            &\leq
            \snorm{w}
            \enorm{v}
        \end{aligned}
    \end{equation}
    Adding together~\eqref{eqn:a-cont-1},~\eqref{eqn:a-cont-2},~\eqref{eqn:a-cont-3},~\eqref{eqn:a-cont-4} and~\eqref{eqn:a-cont-5}, we have
    \begin{equation}
        a(w,v) 
        \leq
        \left(5 + \frac{\linf{\sigma}}{\mu}\right)
        \snorm{w}
        \enorm{v}
    \end{equation}
\end{proof}

\begin{lemma}[Boundedness of $\mathcal{S}$]
    \label{lem:bound-big-s}
    For all $v\in H^1(\Omega)$ we have that
    \begin{equation}
        \ltwo{\mathcal{S}v} \leq \linf{\sigma_T}\|\mathcal{K}\|_{L^2(\Omega\times\Omega)} \ltwo{v},
    \end{equation}
\end{lemma}
\begin{proof}
    By Cauchy-Schwarz, we have
    \begin{equation}
        \left| \int_{\Omega} \mathcal{K}(x,y) v(y)\, \mathrm{d}y \right|^2
        \leq
        \left( \int_{\Omega} |\mathcal{K}(x,y)|^2 \, \mathrm{d}y \right) \|v\|_{L^2}^2.
    \end{equation}
    Thus, by definition of $\mathcal{S}$~\eqref{eqn:def-big-s},
    \begin{equation}
        \begin{aligned}
            \ltwo{\mathcal{S}v} 
            &= \ltwo{\sigma_T(x)\int_\Omega \mathcal{K}(x,y) v(y)\mathrm{d}y}\\
            &\leq
            \linf{\sigma_T} 
            \left(
            \int_\Omega 
            \left| \int_{\Omega} \mathcal{K}(x,y) v(y)\, \mathrm{d}y \right|^2
            \mathrm{d}x
            \right)^{1/2}\\
            &=
            \linf{\sigma_T} 
            \left(
                \int_\Omega 
                \int_\Omega 
                \left| \mathcal{K}(x,y) \right|^2
                \mathrm{d}x
                \mathrm{d}y
            \right)^{1/2}
            \,\ltwo{v}\\
            &= 
            \linf{\sigma_T}\|\mathcal{K}\|_{L^2(\Omega\times\Omega)}
            \ltwo{v}.
        \end{aligned}
    \end{equation}
\end{proof}

\begin{lemma}[Continuity of $s(\cdot,\cdot)$]
    \label{lem:s-cont}
    For all $w,v\in V_h$ we have that
    \begin{equation}
        s(w,v) \leq \tilde{C}_s \ltwo{w} \enorm{v},
    \end{equation}
    and thus (by relation of norms),
    \begin{equation}
        s(w,v) \leq C_s \enorm{w} \enorm{v}.
    \end{equation}
    where 
    \begin{equation}
        C_s = \frac{1}{\mu^{1/2}}\tilde{C}_s = \linf{\sigma_T}\ldouble{\mathcal{K}}\frac{1}{\mu}\left(1 + \mu^{1/2}\delta_\text{max}^{1/2}\right)
    \end{equation}
\end{lemma}
\begin{proof}
    We have 
    \begin{equation*}
        \begin{aligned}
            s(w,v) 
            &=
            \int_{\Omega} (\mathcal{S}w)\, v \, \mathrm{d}x
            + \sum_{K \in \mathscr{T}_h}
            \int_K \delta_K (\mathcal{S}w)\,(\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x \\
            &\leq
            \ltwo{\mathcal{S}w}\ltwo{v}
            +
            \sum_{K \in \mathscr{T}_h}
            \delta_K
            \ltwok{\mathcal{S}w}\ltwok{\mathbf{b}\cdot\nabla v}\\
            &\leq
            \ltwo{\mathcal{S}w}
            \ltwo{v} 
            + 
            \delta_\text{max}^{1/2}
            \ltwo{\mathcal{S}w}
            \left(
                \sum_{K \in \mathscr{T}_h}
                \delta_K
                \ltwok{\mathbf{b}\cdot\nabla v}^2
            \right)^{1/2}\\
            &\leq
            \ltwo{\mathcal{S}w}
            \ltwo{v} 
            +
            \delta_\text{max}^{1/2}
            \ltwo{\mathcal{S}w}
            \enorm{v}\\
            &\leq
            \ltwo{\mathcal{S}w}
            \left(
                \frac{1}{\mu^{1/2}} + \delta_\text{max}^{1/2}
            \right)\enorm{v}\\
            \text{by Lemma~\ref{lem:bound-big-s}, }\\
            &\leq
            \linf{\sigma_T}\|\mathcal{K}\|_{L^2(\Omega\times\Omega)}
            \left(
                \frac{1}{\mu^{1/2}} + \delta_\text{max}^{1/2}
            \right)\ltwo{w}\enorm{v}\\
            &\leq
            \linf{\sigma_T}\|\mathcal{K}\|_{L^2(\Omega\times\Omega)}
            \left(
                \frac{1}{\mu^{1/2}} + \delta_\text{max}^{1/2}
            \right)
            \frac{1}{\mu^{1/2}}
            \enorm{w}\enorm{v}.
        \end{aligned}
    \end{equation*}
    Using~\eqref{eqn:delta-bound}, we take
    \begin{equation}
        \begin{aligned}
            \tilde{C}_s &= \linf{\sigma_T}\|\mathcal{K}\|_{L^2(\Omega\times\Omega)}
            \left(
                \frac{1}{\mu^{1/2}} + \delta_\text{max}^{1/2}
            \right)\\
            C_s &= \frac{1}{\mu^{1/2}}\tilde{C}_s
        \end{aligned}
    \end{equation}
\end{proof}

\begin{corollary}[Coercivity of $a-s$]
    \label{lem:a-s-coer}
    Suppose
    \begin{equation}
        \label{eqn:a-s-coer-1}
        % \linf{\sigma_T}\|\mathcal{K}\|_{L^2(\Omega\times\Omega)}
        % \left(
        %     \frac{1}{\mu} +\frac{1}{\sqrt{2}\linf{\sigma}}
        % \right)
        C_s
        \leq
        \frac{1}{2}.
    \end{equation}
    Then the bilinear form $a-s$ is coercive. That is, there exists an $\alpha>0$ such that for all $v\in V_h$
    \begin{equation}
        a(v,v) - s(v,v) \geq \alpha \enorm{v}^2.
    \end{equation}
\end{corollary}
\begin{proof}
    By Lemma~\ref{lem:a-coer} and Lemma~\ref{lem:s-cont}, we have
    \begin{equation}
        \begin{aligned}
            a(v,v)-s(v,v) 
            &\geq
            \frac{1}{2}\enorm{v}^2 - C_s\enorm{v}\enorm{v}.
        \end{aligned}
    \end{equation}
    By the assumption~\eqref{eqn:a-s-coer-1}, we have
    \begin{equation}
        C_s \leq \frac{1}{2}.
    \end{equation}
    Therefore, taking $\alpha = 1/2 - C_s$,
    \begin{equation}
        a(v,v) - s(v,v) \geq \alpha \enorm{v}^2.
    \end{equation}
\end{proof}

\begin{corollary}[Continuity of $a-s$]
    \label{lem:a-s-cont}
    For all $w,v\in V_h$, we have that
    \begin{equation}
        a(w,v) - s(w,v) \leq C_A \snorm{w}\enorm{v},
    \end{equation}
    where $C_A = C_a + C_s$.
\end{corollary}
\begin{proof}
    By Lemma~\ref{lem:s-cont} and Lemma~\ref{lem:a-cont}, we have
    \begin{equation}
        a(w,v) - s(w,v) \leq C_a \snorm{w}\enorm{v} + C_s\enorm{w}\enorm{v} \leq (C_a + C_s)\snorm{w}\enorm{v}.
    \end{equation}
\end{proof}

\begin{theorem}[Well-posedness]
    Let $g\in H^{1/2}(\partial\Omega)$ with an extension $\hat{g}\in H^1(\Omega)$ such that $\hat{g}|_{\partial\Omega} = g$. Then the variational problem of finding $u\in H^1(\Omega)$ such that $u = g$ on $\Gamma_-$ and
    \begin{eqnarray}
        \label{eqn:lax-2}
        a(u,v) - s(u,v) = l(v) \qquad \forall v\in H_0^1(\Omega)
    \end{eqnarray}
    has a unique solution.
\end{theorem}
\begin{proof}
    Define $\tilde{u} = u - \hat{g}\in H_0^1(\Omega)$. We seek 
    \begin{equation}
        \label{eqn:lax-1}
        a(\tilde{u},v) - s(\tilde{u},v) = \tilde{l}(v) \qquad \forall v\in H_0^1(\Omega)
    \end{equation}
    where
    \begin{equation}
        \tilde{l}(v) = l(v) - a(\hat{g},v) + s(\hat{g}, v).
    \end{equation}
    By Corollary~\ref{lem:a-s-coer} and Corollary~\ref{lem:a-s-cont}, we have that $a-s$ is coercive and bounded. Moreover, $\tilde{l}$ is controlled by the SUPG-norm, with each term bounded since $q\in L^2(\Omega)$ and $\hat{g}\in H^1(\Omega)$.

    Therefore, the Lax-Milgram theorem applies to give a unique $\tilde{u}$ solving~\eqref{eqn:lax-1}, hence a unique $u = \tilde{u}+\hat{g}$ solving~\eqref{eqn:lax-2}.
\end{proof}


</subsection>

<subsection xml:id="fe-det">
    <title>Finite Element Error</title>
    <p>
        We consider the first term in the triangle inequality in~\eqref{eqn:triangle-ineq}. That is, we find an error estimate and convergence rate for the theoretical finite element solution $u_h\in V_h$ of~\eqref{eqn:FE-problem}. 
    </p>

\begin{theorem}[C\'{e}a-type best-approximation estimate]
    \label{thm:best-approx}
    Let $u\in H^1_0$ be a solution of~\eqref{eqn:strong} with $g=0$ and let $u_h\in V_h$ be a solution of~\eqref{eqn:FE-problem}. Then we have the following best approximation result:
    \begin{equation}
        \enorm{u - u_h}
        \leq 
        \left(1 + \frac{C_A}{\alpha}\right)
        \inf_{w_h \in V_h} 
        \snorm{u - w_h}.
    \end{equation}
\end{theorem}
\begin{proof}
    Let $w_h\in V_h$ be arbitrary, we split the error as
    \begin{equation}
        \label{eqn:best-appro-1}
        u - u_h
        = (u - w_h)
        + \underbrace{(w_h - u_h)}_{\phi_h \in V_h}.
    \end{equation}
    Applying coercivity to $A = a-s$ (Corollary~\ref{lem:a-s-coer}), we have
    \begin{equation}
        \alpha \enorm{\phi_h}^2
        \leq
        A(\phi_h, \phi_h) = A(w_h-u_h, \phi_h).
    \end{equation}
    We insert the exact solution $u$ into the first slot,
    \begin{equation}
        \begin{aligned}
            A(w_h-u_h, \phi_h)
            &=
            A(w_h-u + u-u_h, \phi_h)\\
            &=
            A(w_h-u, \phi_h) + A(u-u_h, \phi_h)\\
            &=
            A(w_h-u, \phi_h),
        \end{aligned}
    \end{equation}
    where the last equality is due to Galerkin orthogonality.
    By continuity (Corollary~\ref{lem:a-s-cont}), we have
    \begin{equation}
        \begin{aligned}
            \alpha \enorm{\phi_h}^2
            \leq
            A(w_h-u, \phi_h)
            \leq
            C_A\snorm{w_h - u} \enorm{\phi_h}.
        \end{aligned}
    \end{equation}
    Thus,
    \begin{equation}
        \enorm{\phi_h} \leq \frac{C_A}{\alpha}\snorm{w_h - u}.
    \end{equation}
    Applying the triangle inequality to~\eqref{eqn:best-appro-1}, 
    \begin{equation}
        \begin{aligned}
            \enorm{u-u_h}
            &\leq
            \enorm{u - w_h}
            +
            \enorm{\phi_h}\\
            &\leq
            \snorm{u - w_h}
            +
            \frac{C_A}{\alpha}\snorm{w_h - u}\\
            &=
            \left(
                1 + \frac{C_A}{\alpha}
            \right)\snorm{w_h - u}.
        \end{aligned}
    \end{equation}
    Taking the infimum over $w_h\in V_h$, we have the result
    \begin{equation}
        \enorm{u - u_h}
        \leq 
        \left(1 + \frac{C_A}{\alpha}\right)
        \inf_{w_h \in V_h} 
        \snorm{u - w_h}.
    \end{equation}
\end{proof}

% \begin{proof}
%     Let $e = u-u_h$, take $v_h\in V_h$ arbitrarily. By Lemma~\ref{lem:a-s-coer},
%     \begin{equation}
