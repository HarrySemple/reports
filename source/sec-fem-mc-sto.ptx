<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="sec-fem-mc-sto" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Preliminaries</title>


  <!-- use hyperlinks to reference -->
   <!--first populate, then find-replace for the links.
   references to be reformatted added later.
   add references to end of each section as you go along.-->  
  
<subsection>
    <title>Introduction</title>
    <p>
        Now we consider the case of inexact computation of the scattering form, <m>s(\cdot,\cdot)</m>, through Monte-Carlo integration.
    </p>

    <p>
        That is, we approximate the nonlocal term of <xref ref="eqn-strong"/> as
        <md number="yes" xml:id="eqn-monte-carlo-approx">
            \label{eqn:monte-carlo-approx}
            \int_\Omega \mathcal{K}(x,y)u(y)\mathrm{d}y
            \approx
            \frac{|\Omega|}{M} \sum_{j=1}^M \mathcal{K}(x,Y_j)u(Y_j)
        </md>
        where <m>\{y_j\}_{j=1}^M</m> are random samples from <m>\Omega</m>.
    </p>

<p>
This leads us to a modified iterative finite element problem to be solved in practice. Given an initial estimate <m>u_h^{(0)}\in V_h</m>, we compute for all <m>n\in\mathbb{N}</m>
<md number="yes" xml:id="eqn-iter-prob-mc">
    \label{eqn:iter-prob-MC}
    a(u_h^{(n)}, v) = s_M(u_h^{(n-1)}, v) + l(v) \qquad \forall v\in V_h,
</md>
where
<md number="yes" xml:id="eqn-s-m">
    \label{eqn:s-M}
    s_M(u,v) :=
    \int_{\Omega} (\mathcal{S}_M u)\, v \, \mathrm{d}x
    + \sum_{K \in \mathscr{T}_h}
    \int_K \delta_K (\mathcal{S}_M u)\,(\boldsymbol{b}\cdot\nabla v)\, \mathrm{d}x ,
</md>
where 
<md number="yes" xml:id="eqn-def-big-s-m">
    \label{eqn:def-big-s-M}
    (\mathcal{S}_M u)(x) := \sigma_T(x) \frac{|\Omega|}{M} \sum_{j=1}^M \mathcal{K}(x,Y_j)u(Y_j),
</md>
for random draws <m>\{y_j\}_{j=1}^M</m> from <m>\Omega</m>.
</p>


<p>
To account for this in our analysis, we similarly modify the theoretical steady-state finite element problem. Placing <m>s_M</m> in <xref ref="eqn-fe-problem"/>, we seek to find <m>u_h\in V_h</m> such that
<md number="yes" xml:id="eqn-fe-prob-mc">
    \label{eqn:FE-prob-MC}
    a(u_h, v) = s_M(u_h, v) + l(v) \qquad \forall v\in V_h.
</md>
</p>

</subsection>
<subsection xml:id="subsec-fe-sto">
    <title>FE Steady State Error</title>
    
<p>
We must modify the analysis for our previous Best Approximation result (<xref ref="thm-best-approx"/>) in light of <m>u</m> and <m>u_h</m> satisfying different variational formulations. Indeed, the true solution <m>u</m> still solves the variational form <xref ref="eqn-fe-problem"/> while <m>u_h</m> is now treated as the solution to <xref ref="eqn-fe-prob-mc"/> as the steady state of <m>\{u_h^{(n)}\}_{n\in\mathbb{N}_0}</m>.
</p>



<theorem xml:id="thm-strang">
    <title>Strang-Type Error Estimate</title>
    <statement><p>
    \label{thm:strang}
    Let <m>u\in H^1_0(\Omega)</m> be the solution of <xref ref="eqn-strong"/> and <m>u_h</m> the solution of <xref ref="eqn-fe-prob-mc"/>. Then,
    <md number="yes">
        \enorm{u - u_h}
        \leq (1 + C_a)\, \inf_{w_h \in V_h}
        \snorm{u - w_h}
        +
        \sup_{v_h \in V_h}
        \frac{\left| s(u, v_h) - s_M(u_h, v_h) \right|}{\enorm{v_h}}.
    </md>
</p></statement></theorem>

<proof><p>
    Let <m>w_h\in V_h</m> be arbitrary. We define <m>e_h = w_h - u_h\in V_h</m>.
    By <xref ref="lem-well-posed"/> and by definition of <m>u_h</m>, we have that
    <md number="yes">
        a(u-u_h,e_h) = s(u,e_h) - s_M(u_h,e_h).
    </md>
    Splitting the first argument of <m>a(\cdot,\cdot)</m> with <m>w_h</m>, we have:
    <md number="yes">
        a(w_h-u_h,e_h) = a(w_h-u,e_h) + s(u,e_h) - s_M(u_h,e_h).
    </md>
    By coercivity of <m>a(\cdot,\cdot)</m>, we have
    <md number="yes">
        <mrow>
            \frac{1}{2}\enorm{e_h}^2
            &amp;\leq
            a(e_h,e_h)
        </mrow>
        <mrow>
            &amp;=
            a(w_h - u_h,e_h)
        </mrow>
        <mrow>
            &amp;=
            a(w_h-u,e_h) + s(u,e_h) - s_M(u_h,e_h)
        </mrow>
        <mrow>
            &amp;\leq
            C_a \snorm{w_h-u}\enorm{e_h}
            + s(u,e_h) - s_M(u_h,e_h).
        </mrow>
    </md>
    Where the last inequality is due to continuity of <m>a(\cdot,\cdot)</m>.
    Now, we have
    <md number="yes">
        <mrow>
                s(u,e_h) - s_M(u_h,e_h)
            &amp;= 
            \enorm{e_h}\frac{s(u,e_h) - s_M(u_h,e_h)}{\enorm{e_h}}
        </mrow>
        <mrow>
            &amp;\leq
            \enorm{e_h}\sup_{v_h\in V_h}\frac{|s(u,v_h) - s_M(u_h,v_h)|}{\enorm{v_h}}.
        </mrow>
    </md>
    Thus, we have
    <md number="yes">
        \enorm{w_h - u_h}
        \leq
        C_a \snorm{w_h-u}
        +
        \sup_{v_h\in V_h}\frac{|s(u,v_h) - s_M(u_h,v_h)|}{\enorm{v_h}}.
    </md>
    The result follows from the triangle inequality,
    <md number="yes">
        <mrow>
            \enorm{u-u_h}
            &amp;\leq
            \enorm{u - w_h} + \enorm{w_h - u_h}</mrow><mrow>
            &amp;\leq
            (1+C_a) \snorm{u-w_h}
            +
            \sup_{v_h\in V_h}\frac{|s(u,v_h) - s_M(u_h,v_h)|}{\enorm{v_h}}.</mrow>
    </md>
    and taking the infimum over <m>w_h</m>.
</p></proof>

<proposition xml:id="prop-prob-bound">
    <title>Probabilistic Bound for Monte-Carlo Consistency</title>
    <statement>
        <p>
    Suppose that <m>\mathcal{K}\in L^\infty(\Omega\times\Omega)</m>.
    We have that, with probability <m>1-\eta</m>,
    <md number="yes">
        \frac{|s(u,v_h) - s_M(u_h,v_h)|}{\enorm{v_h}}
        \leq
        C_s\enorm{u-u_h}
        +
        B\sqrt{\frac{2}{M}\log\left(\frac{2}{\eta}\right)}
    </md>
    
</p>
</statement>
</proposition>

<proof><p>
    We first split into compatible arguments:
    <md number="yes">
            <mrow>s(u,v_h) - s_M(u_h,v_h)
            &amp;=
            s(u - u_h,v_h) + s(u_h,v_h) - s_M(u_h,v_h)</mrow><mrow xml:id="eqn-prop-2">
            &amp;\leq
            C_s\enorm{u-u_h}\enorm{v_h}
            +
            \left[s(u_h,v_h) - s_M(u_h,v_h)\right].</mrow>
    </md>
    The remainder of this proof focuses on the second term. We have
    <md number="yes">
            <mrow>s(u_h,v_h) - s_M(u_h,v_h)
            &amp;=
            \int_\Omega 
            \left[
                \left(\mathcal{S}u_h\right)(x)
                -
                \left(\mathcal{S}_M u_h\right)(x)
            \right]v_h(x) \mathrm{d}x</mrow><mrow>
            &amp;\quad
            +
            \sum_{K} \int_{K} \delta_K \left[
                (\mathcal{S} u_h)(x) - (\mathcal{S}_M u_h)(x)
            \right]\, (\mathbf{b} \cdot \nabla v_h(x))\, dx.</mrow>
    </md>
    For a test function <m>v_h\in V_h</m>, we define the following random variables for <m>j\in\{1,\ldots,M\}</m>
    <md number="yes">
            <mrow>W_j(v_h) &amp;= |\Omega| \int_{\Omega} \mathcal{K}(x, Y_j)\, u_h(Y_j)\, \sigma_T(x) v_h(x)\, dx</mrow><mrow xml:id="eqn-prop-1">
            &amp;= |\Omega|\, u_h(Y_j) \int_{\Omega} \mathcal{K}(x, Y_j)\, \sigma_T(x) v_h(x)\, dx,</mrow>
    </md>
    <md number="yes">
        X_j(v_h) = |\Omega|\, u_h(Y_j)
        \sum_{K} \int_{K} \delta_K \, \sigma_T(x)\, \mathcal{K}(x, Y_j)\, (\mathbf{b} \cdot \nabla v_h)(x)\, dx.
    </md>
    where <m>\{Y_j\}_{j=1}^{M}</m> are i.i.d uniform random variables on <m>\Omega</m>. We have
    <md number="yes">
        s_M(u_h, v_h)
        = \frac{1}{M} \sum_{j=1}^{M} 
        (W_j(v_h) + X_j(v_h)).
    </md>
    As <m>Y_j</m> are independent uniform RVs on <m>\Omega</m>, this yields an unbiased estimate of the true scattering form:
    <md number="yes">
        \mathbb{E}[W_j(v_h)+X_j(v_h)] = s(u_h, v_h).
    </md>
    In order to apply Hoeffding's inequality, we must also bound these RVs. The integral inside <xref ref="eqn-prop-1"/> is bounded via Cauchy-Schwarz as
    <md number="yes">
        \left| \int_{\Omega} \mathcal{K}(x, Y_j)\, \sigma_T v_h(x)\, dx \right|
        \leq \|\mathcal{K}\|_{L^\infty(\Omega\times\Omega)}
        \linf{\sigma_T} |\Omega|^{1/2} \|v_h\|_{L^2(\Omega)}.
    </md>
    Thus, we have
    <md number="yes">
            \left| W_j(v_h) \right|
            \leq 
            \underbrace{|\Omega|^{3/2} \, \|\mathcal{K}\|_{L^\infty(\Omega\times\Omega)}
            \linf{\sigma_T} \, \linf{u_h}\frac{1}{\mu^{1/2}}}_{B_1}
            \, 
            \enorm{v_h}.
    </md>
    Similarly, we have
    <md number="yes">
        |X_j(v_h)|
        \leq
        \underbrace{|\Omega|^{3/2} \, \|\mathcal{K}\|_{L^\infty(\Omega\times\Omega)} \, \linf{u_h} \, \linf{\sigma_T} \, \delta_{\max}^{1/2}}_{B_2} \, \enorm{v_h}.
    </md>
    Combining these, we have i.i.d. RVs <m>\{Z_j = W_j + X_j\}_{j=1}^M</m> bounded by 
    <md number="yes">
        |Z_j|\leq (B_1+B_2)\enorm{v_h} = B\enorm{v_h}.
    </md>
    We can thus apply Hoeffding's inequality,
    <md number="yes">
        \mathbb{P}\left(
        \left| \frac{1}{M} \sum_{j=1}^{M} Z_j - \mathbb{E}Z_1 \right| \geq t
        \right)
        \leq 2 \exp\left(
        -\frac{M t^2}{2 B^2 \enorm{v_h}^2}
        \right).
    </md>
    Setting <m>t = B \enorm{v_h} \sqrt{\frac{2 \log(2/\eta)}{M}}</m> gives, with probability at least <m>1-\eta</m>,
    <md number="yes" >
        \left| s(u_h, v_h) - s_M(u_h, v_h) \right|
        \leq B \enorm{v_h} \sqrt{\frac{2 \log(2/\eta)}{M}}.
    </md>
    Combining with <xref ref="eqn-prop-2"/> and dividing by <m>\enorm{v_h}</m> yields the result.
</p></proof>

<corollary xml:id="cor-mc-ss-err">
    <title>Error Estimate for the Steady State</title>  
    <statement>
        <p>
    \label{cor:MC-ss-err}
    Suppose <m>u\in H^1_0(\Omega)</m> is the solution of <xref ref="eqn-strong"/> and <m>u_h</m> the solution of <xref ref="eqn-fe-prob-mc"/>. 
    Given that <m>\mathcal{K}\in L^\infty(\Omega\times\Omega)</m> and <m>C_s\leq 1</m>, we have with probability at least <m>1-\eta</m>
    <md number="yes" >
        \enorm{u-u_h}
        \leq
        \frac{1+C_a}{1-C_s} C h^{\min\{k+1,r\} - 1/2} |u|_{H^r(\Omega)}
        +
        \frac{B}{1-C_s} \sqrt{\frac{2}{M}\log\left(\frac{2}{\eta}\right)}
    </md>    
        </p>
    </statement>
</corollary>


<proof><p>
    The result follows from combining <xref ref="thm-strang"/> and <xref ref="prop-prob-bound"/>.
    We have, with probability <m>1-\eta</m>
    <md number="yes">
            \enorm{u-u_h}
            \leq
            (1+C_a)\inf_{w_h\in V_h}\snorm{u-w_h} + C_s \enorm{u - u_h}
            + B\sqrt{\frac{2}{M}\log\left(\frac{2}{\eta}\right)}.
    </md>
    Rearranging for <m>\enorm{u-u_h}</m> gives the result.
</p></proof>


</subsection>
<subsection xml:id="subsec-iter-sto">
    <title>FE Source Iteration Error</title>
    
    <p>
The adjustments required for our previous source iteration analysis are comparatively straightforward.
Indeed, <m>s_M(\cdot,\cdot)</m> appears in both <xref ref="eqn-fe-prob-mc"/> and <xref ref="eqn-iter-prob-mc"/>, meaning we don't have to use a Monte Carlo consistency bound as for the steady state error analysis. 
    </p>

<p>
    Instead, all that is needed for our convergence results (<xref ref="thm-conv-l2"/> and <xref ref="cor-conv-supg"/>) to carry over is that <m>s_M(\cdot,\cdot)</m> admits a continuity result equivalent to <xref ref="lem-s-cont"/>. By bounding <m>\mathcal{K}</m> above by its infinity-norm evaluated everywhere on the domain, we arrive at the following:
    <md number="yes" xml:id="eqn-sm-cont">
        \label{eqn:sM-cont}
        s_M(w,v) \leq C_s^M \enorm{w}\enorm{v},
    </md>
    where
    <md number="yes" >
        C_s^M = \|\sigma_T\|_{L^\infty(\Omega)} \, \|K\|_{L^\infty(\Omega \times \Omega)}|\Omega|
        \left( 1 + \delta_{\max}^{1/2}\mu^{1/2} \right)
        \frac{1}{\mu}.
    </md>
    This leads directly to an extension of <xref ref="cor-conv-supg"/>.
</p>

<corollary xml:id="cor-conv-supg-MC">
    <title>Convergence in SUPG-Norm with MC Approximation</title>
    
    
    <statement>
        <p>
    \label{cor:conv-supg-MC}
    Let <m>u_h</m> be the solution of <xref ref="eqn-fe-prob-mc"/>, <m>u_h^{(0)}\in V_h</m> arbitrary and <m>\{u_h^{(n)}\}_{n\in\mathbb{N}}</m> the sequence defined by <xref ref="eqn-iter-prob-mc"/>.
    Given <m>\mathcal{K}\in L^\infty(\Omega\times\Omega)</m>, we have for all <m>n\in\mathbb{N}_0</m>,
    <md number="yes" >
        \enorm{u_h - u_h^{(n)}}
        \leq (2C_s^M)^n
        \enorm{u_h - u_h^{(0)}}.
    </md>
        </p>
    </statement>
</corollary>


<proof><p>
    The proof is identical to that of <xref ref="cor-conv-supg"/>, using <xref ref="eqn-sm-cont"/> in place of <xref ref="lem-s-cont"/>.
</p></proof>


</subsection>
<subsection xml:id="subsec-combined-sto">
    <title>Combined Error Estimate</title>
    
<p>
    We now combine these strands into a single error estimate.
</p>

<theorem xml:id="thm-sto">
    <title>Error Estimate with Monte Carlo Integration</title>
    <statement><p>
    \label{thm:sto}
    Suppose <m>u</m> is the solution of <xref ref="eqn-strong"/>.
    Let <m>u_h</m> be the solution of <xref ref="eqn-fe-prob-mc"/>, <m>u_h^{(0)}\in V_h</m> arbitrary and <m>\{u_h^{(n)}\}_{n\in\mathbb{N}}</m> the sequence defined by <xref ref="eqn-iter-prob-mc"/>.
    Given <m>\mathcal{K}\in L^\infty(\Omega\times\Omega)</m>, we have for all <m>n\in\mathbb{N}_0</m>, with probability <m>1-\eta</m>,
    <md number="yes">
            \enorm{u - u_h^{(n)}}
            \leq
            \tilde{C} h^{\min\{k+1,r\} - 1/2} |u|_{H^r(\Omega)}
            +
            \tilde{B} \sqrt{\frac{2}{M}\log\left(\frac{2}{\eta}\right)}
            + \left( 2 C_s^M \right)^{n}
            \enorm{u_h - u_h^{(0)}}
    </md>
</p></statement></theorem>
<proof><p>
    Similar to <xref ref="thm-det"/>, the result follows from splitting <m>\enorm{u - u_h^{(n)}}</m> with the triangle inequality <xref ref="eqn-triangle-ineq"/>, then applying <xref ref="cor-mc-ss-err"/> and <xref ref="cor-conv-supg-MC"/>.
</p></proof>

</subsection>

</section>