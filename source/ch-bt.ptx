\subsection*{Prony's Method}
For $M$ receivers and $N$ signals, we have
\begin{equation}
    \label{"eqn:scalar-model"}
    y_m = \sum_{n=1}^N A_n \exp\big\{j(\phi_n+\sin(\theta_n)(m-1))\big\}, \qquad m = 1,...,M.
\end{equation}
Firstly, we note that we require $M\ge N$ in order for us to determine $N$ unknowns, $\{\theta_n\}_{n=1}^N$, from $M$ equations.\\
We reformulate (\ref{"eqn:scalar-model"}) for Prony's method by separating constituent signals into their complex envelope, $s_n = A_n e^{j\phi_n}$ and carrier exponent, $z_n = j\sin(\theta_n)$.
\begin{align*}
    y_m &= \sum_{n=1}^N A_n e^{j\phi_n}e^{j\sin(\theta_n)(m-1)}
    = \sum_{n=1}^N s_n e^{z_n (m-1)}
\end{align*}
Expanding this expression, we arrive at the system of equations
\begin{equation}
    \label{"eqn:system-1"}
    \begin{aligned}
        y_1 &= s_1 + s_2 + \cdots + s_N\\
        y_2 &= s_1z_1 + s_2z_2 + \cdots + s_N z_N\\
        &\vdots\\
        y_M &= s_1z_1^{M-1} + s_2z_2^{M-1}\cdots + s_N z_N^{M-1}
    \end{aligned}
\end{equation}
Now, suppose $z_1, ..., z_N$ are roots of 
\begin{equation}
    \label{eqn:polynomial}
    \beta_1  + \beta_2 z + \cdots + \beta_{N+1} z^N = 0,
\end{equation}
where $(\beta_i)_{i=1}^N$ are unknown coefficients.

We take $\beta_{N+1} = 1$. If we are able to find the coefficients $\beta_1,...,\beta_N$, it only remains to compute roots of this polynomial to retrieve $z_n$, and hence $\theta_n$.

Using these coefficients, we are able to manipulate the problem into a constant coefficient linear difference equation\cite{ouibrahim1986generalized}. We start by multiplying the first $N+1$ equations in (\ref{"eqn:system-1"}) by the corresponding coefficients,

\begin{equation}
    \begin{aligned}
        \beta_1 y_1 &= \beta_1 s_1 + \cdots + \beta_1 s_N \\
        \beta_2 y_2 &= \beta_2 s_1 z_1 + \cdots + \beta_2 s_N z_N\\
        &\vdots \\
        \beta_N y_N &= \beta_N s_1 z_1^{N-1} + \cdots + \beta_N s_N z_N^{N-1}\\
        y_{N+1} &=  s_1 z_1^N+ \cdots +  s_N z_N^N.
    \end{aligned}
\end{equation}
Adding these equations together, we get
\begin{equation}
    \begin{aligned}
        \beta_1 y_1 + \cdots + \beta_N y_N\quad =\quad &s_1 \big(\beta_1 + \beta_2z_1 + \cdots \beta_N z_1^N + z_1^{N+1} \big) \\
        +&s_2 \big(\beta_1 + \beta_2z_2 + \cdots \beta_N z_2^N + z_2^{N+1} \big) \\
        &\vdots \\
        +&s_2 \big(\beta_1 + \beta_2z_2 + \cdots \beta_N z_2^N + z_2^{N+1} \big)
    \end{aligned}
\end{equation}
due to $\{z_n\}_{n=1}^N$ being roots of the polynomial in (\ref{eqn:polynomial}), we arrive at the identity
\begin{equation}
    \beta_1 y_1 + \cdots + \beta_N y_N + y_{N+1} = 0.
\end{equation}  
This is a constant coefficient linear difference equation, and we can repeat this process for the next $M-N-1$ equations to arrive at the system
\begin{equation}
    \label{eqn:system-2}
    \begin{aligned}
        \beta_1 y_1 + \cdots + \beta_N y_N &= - y_{N+1}\\
        \beta_1 y_2 + \cdots + \beta_N y_{N+1} &= -y_{N+2} \\
        &\vdots\\
        \beta_1 y_{M-N} + \cdots + \beta_N y_{M-1} &= -y_M.
    \end{aligned}
\end{equation}
Writing this system in matrix form, we have
\begin{equation}
    \begin{bmatrix}
        y_1 & y_2 & \cdots & y_{N}\\
        y_2 & y_3 & \cdots & y_{N+1}\\
        \vdots & \vdots & \ddots & \vdots\\
        y_{M-N} & y_{M-N+1} & \cdots & y_{M-1}
    \end{bmatrix}
    \begin{bmatrix}
        \beta_1\\
        \beta_2\\
        \vdots\\
        \beta_N
    \end{bmatrix}
    = - \begin{bmatrix}
        y_{N+1}\\
        y_{N+2}\\
        \vdots\\
        y_{M}
    \end{bmatrix}
\end{equation}
which is an $(M-N)\times N$ system of equations. Thus, we require $M\ge 2N$ for this system to not be underdetermined. We solve for $\beta_1,...,\beta_N$ using linear least squares.


% \newpage


\subsection*{ESPRIT}
The Estimation of Signal Parameters via Rotational Invariance Techniques (ESPRIT) algorithm provides another method for approximating DOAs based on subspace techniques and principle component analysis \cite{ouibrahim1986generalized} (a brief introduction to subspace techniques is provided in the appendix). Historically, ESPRIT was developed for frequency estimation with measurements taken at $M$ pairs of receivers ("doublets") which are separated by a known constant displacement vector. To implement ESPRIT on a uniform linear array, ESPRIT makes use two "offset by one" subsets: $\{y_i\}_{i=1}^{M-1}$ and $\{y_i\}_{i=2}^{M}$. Finally, for relevance to our later experiments, we introduce time dependency in our measurements and signals $\mathbf{y}(t), \mathbf{z}(t)$, $t=1,...,T$. To apply ESPRIT, we assume $T>>M$.

Define
\begin{equation}
    Y = \big[\mathbf{y}(1) \cdots \mathbf{y}(T)\big],
\  Z = \big[\mathbf{z}(1) \cdots \mathbf{z}(T)\big]\in \mathbb{C}^{M \times T}.
\end{equation}
Analogous to (\ref{eqn:lin-op}), we have 
\begin{equation}
    \label{eqn:lin-op-time}
    Y = BZ + N
\end{equation}
where $N\in \mathbb{C}^{M\times T}$ is the matrix of noise vectors.
The singular value decomposition (SVD) of $Y$ given by
\begin{equation}
    Y = U\big[\Lambda \quad 0\big]V^\dagger
\end{equation}
where $U\in\mathbb{C}^{M\times M}$, $V\in\mathbb{C}^{T\times T}$ are unitary matrices and $\Lambda \in\mathbb{C}^{M\times M}$ is a diagonal matrix of singular values.
As outlined in the previous section, we assume that the $\tilde{N}$ largest singular values in our measured $Y$ correspond to the signals.
We write
\begin{equation}
    U = \big[U_\text{signal}\quad U_\text{noise}\big], 
    \quad \Lambda = 
    \begin{bmatrix}
        \Lambda_\text{signal} & 0\\
        0 & \Lambda_\text{noise}
    \end{bmatrix}, 
    \quad V = \big[V_\text{signal}\quad V_\text{noise} \quad V_0\big],
\end{equation}
we have that the SVD can be written as 
\begin{equation}
    \label{eqn:two-svd}
    Y = U_\text{signal}\Lambda_\text{signal}V_\text{signal}^\dagger + U_\text{noise}\Lambda_\text{noise}V_\text{noise}^\dagger.
    %= BZ + N
\end{equation}
Thus, we recover the signal subspace as the first $\tilde{N}$ columns of $U$ and $V$ and the corresponding singular values in $\Lambda$.
Combining (\ref{eqn:lin-op-time}) and (\ref{eqn:two-svd}), we have
\begin{equation}
    \label{eqn:u-signal}
    U_\text{signal} = BF = BZV_\text{signal}\Lambda_\text{signal}^{-1}.
\end{equation}
Now we use the properties of the uniform linear array - specifically, that the steering matrix $B$ is a Vandermonde matrix.
Define $\Phi = \text{diag}\big[e^{j\sin(\theta_1)},..., e^{j\sin(\theta_k)}\big]$. By definition of $B$, we have
\begin{equation}
    \label{eqn:vandermonde-prop}
    \big[0 \quad I_{M-1}\big]B = \big[I_{M-1} \quad 0\big]B\Phi.
\end{equation}
Combining the expressions (\ref{eqn:u-signal}) and (\ref{eqn:vandermonde-prop}), we have
% \begin{equation}
\begin{align}
    \big[0 \quad I_{M-1}\big]U_\text{signal}F^{-1} &= \big[I_{M-1} \quad 0\big]U_\text{signal}F^{-1}\Phi\\
    \implies \big[0 \quad I_{M-1}\big]U_\text{signal} &= \big[I_{M-1} \quad 0\big]U_\text{signal}F^{-1}\Phi F.
\end{align}
% \end{equation}
We thus have a relation between the two truncated signal spaces
\begin{equation}
    \bigg(\big[0 \quad I_{M-1}\big]U_\text{signal}\bigg) = \bigg(\big[I_{M-1} \quad 0\big]U_\text{signal}\bigg)P,
\end{equation}
where $P=F^{-1}\Phi F$.

That is, solving the relation between the two truncated signal subspaces gives us a matrix $P$. From its eigenvalue decomposition $F^{-1}\Phi F$ (and by definition of $\Phi$), we retrieve the DOAs $\{\theta_i\}_{i=1}^{\tilde{N}}$ with the relation
\begin{equation}
    \theta_i = \arcsin(\arg\lambda_i),
\end{equation} 
where $\arg\lambda_i$ denotes the phase of the $i^\text{th}$ eigenvalue.




